# ---------------------------------------------------------------------------
# SwitchCart — environment template. Copy to `.env` and fill in what you have.
# The app runs fully WITHOUT any keys (deterministic simulation mode).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- PayPal Sandbox (Orders v2, intent=AUTHORIZE) ---------------------------
# Get credentials at https://developer.paypal.com/dashboard/ -> Apps & Credentials
# If these are unset, SwitchCart uses its deterministic PayPal simulator and
# marks every audit event with simulated=true.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox base URL (default). Use https://api-m.paypal.com only for live.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- AI substitution engine (OpenAI-compatible Chat Completions) ------------
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, Ollama, ...).
# If AI_API_KEY is unset or the call fails, a deterministic rule-based
# fallback (switchcart-rules-v1) proposes replacements instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Demo failure knobs (simulation mode only) -------------------------------
# Set to "1" to force a 422 from the simulated capture/reauthorize call,
# useful to demo the error states.
SIM_FORCE_CAPTURE_FAILURE=
SIM_FORCE_REAUTHORIZE_FAILURE=
